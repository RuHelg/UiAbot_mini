<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schemas/model/1.0">

  <!-- Joint State Publisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

<!-- convenient noise macro + properties -->
<xacro:property name="imu_ang_std" value="2e-4"/>
<xacro:property name="imu_lin_std" value="1.7e-2"/>

<xacro:macro name="gaussian_noise" params="mean stddev">
  <noise type="gaussian">
    <mean>${mean}</mean>
    <stddev>${stddev}</stddev>
  </noise>
</xacro:macro>

<!-- IMU Sensor -->
  <gazebo reference="bno055">
   <sensor name="bno055" type="imu">
   <always_on>true</always_on>
   <update_rate>100</update_rate>
   <visualize>true</visualize>
   <topic>bno055/imu</topic>
   <gz_frame_id>bno055</gz_frame_id>
        <imu>
        <angular_velocity>
        <x><xacro:gaussian_noise mean="0.0" stddev="${imu_ang_std}"/></x>
        <y><xacro:gaussian_noise mean="0.0" stddev="${imu_ang_std}"/></y>
        <z><xacro:gaussian_noise mean="0.0" stddev="${imu_ang_std}"/></z>
        </angular_velocity>
        <linear_acceleration>
        <x><xacro:gaussian_noise mean="0.0" stddev="${imu_lin_std}"/></x>
        <y><xacro:gaussian_noise mean="0.0" stddev="${imu_lin_std}"/></y>
        <z><xacro:gaussian_noise mean="0.0" stddev="${imu_lin_std}"/></z>
        </linear_acceleration>
        </imu>
   </sensor>
  </gazebo>

  <!-- LiDAR Sensor -->
  <gazebo reference="lidar_link">
   <sensor name="lidar_link" type="gpu_lidar">
    <always_on>true</always_on>
    <visualize>false</visualize>
    <update_rate>12</update_rate>
    <topic>scan</topic>
    <gz_frame_id>lidar_link</gz_frame_id>
    <ray>
     <scan>
      <horizontal>
       <samples>360</samples>
       <resolution>1</resolution>
       <min_angle>0</min_angle>
       <max_angle>6.28318</max_angle>
      </horizontal>
     </scan>
     <range>
       <min>0.12</min>
       <max>12.0</max>
       <resolution>0.015</resolution>
     </range>
    </ray>
   </sensor>
  </gazebo>

</robot>