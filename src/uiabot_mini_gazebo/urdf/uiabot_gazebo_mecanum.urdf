<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schemas/model/1.0" name="uiabot_mini_gazebo_mecanum" >
<xacro:include filename="$(find uiabot_mini_description)/urdf/uiabot_mecanum.xacro" />
<xacro:include filename="uiabot_gazebo_common.urdf" />

  <xacro:property name="wheel_mu" value="1.0"/>
  <xacro:property name="wheel_mu2" value="0.0"/>

  <xacro:macro name="wheel_friction" params="link fdir">
  <gazebo reference="${link}">
    <collision>
      <surface>
        <friction>
          <mu>${wheel_mu}</mu>
          <mu2>${wheel_mu2}</mu2>
          <fdir1 gz:expressed_in="base_link">${fdir}</fdir1>
        </friction>
      </surface>
    </collision>
  </gazebo>
</xacro:macro>

<xacro:wheel_friction
  link="front_left_wheel"
  fdir="1 -1 0"/>

<xacro:wheel_friction
  link="front_right_wheel"
  fdir="1 1 0"/>

<xacro:wheel_friction
  link="rear_left_wheel"
  fdir="-1 -1 0"/>

<xacro:wheel_friction
  link="rear_right_wheel"
  fdir="-1 1 0"/>

  <!-- Gazebo mecanum plugin-->
  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheelbase>${wheel_base}</wheelbase>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>/wheel_encoder_odometry</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

</robot>