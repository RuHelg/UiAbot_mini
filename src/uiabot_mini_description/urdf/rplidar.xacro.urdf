<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ========= LIDAR (RPLidar) ========= -->
  <xacro:property name="lidar_x" value="0"/>
  <xacro:property name="lidar_y" value="0"/>
  <xacro:property name="lidar_z" value="188.85e-3"/>

  <link name="lidar_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
         <mesh filename="package://uiabot_mini_description/meshes/rplidar.STL"/>
      </geometry>
      <origin xyz="${-lidar_x} ${-lidar_y} ${-lidar_z}" rpy="0 0 ${-pi}"/>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z + wheel_radius}" rpy="0 0 ${pi}"/>
  </joint>
  
</robot>
