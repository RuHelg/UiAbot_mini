<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wheel_link" params="name link_mesh wheel_radius joint_origin joint_rpy visual_rpy">
    <joint name="${name}_joint" type="continuous">
      <origin xyz="${joint_origin}" rpy="${joint_rpy}"/>
      <parent link="base_link"/>
      <child link="${name}"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${name}">
      <collision>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <visual>
        <origin rpy="${visual_rpy}"/>
        <geometry>
          <mesh filename="${link_mesh}"/>
        </geometry>
        <material name="purple">
          <color rgba="0.5 0.0 0.5 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="${wheel_ixy}" ixz="${wheel_ixz}" 
                 iyy="${wheel_iyy}" iyz="${wheel_iyz}" izz="${wheel_izz}"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>