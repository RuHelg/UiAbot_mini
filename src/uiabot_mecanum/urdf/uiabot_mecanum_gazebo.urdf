<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schemas/model/1.0" >

  <!-- Mecanum Wheel Friction Models -->
  <gazebo reference="front_left_wheel">
    <material>
      <ambient>0.2 0.2 0.2 1.0</ambient>
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
    </material>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="front_right_wheel">
    <material>
      <ambient>0.2 0.2 0.2 1.0</ambient>
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
    </material>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="rear_left_wheel">
    <material>
      <ambient>0.2 0.2 0.2 1.0</ambient>
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
    </material>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">-1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="rear_right_wheel">
    <material>
      <ambient>0.2 0.2 0.2 1.0</ambient>
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
    </material>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">-1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ROS2 Control Interface -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

<!-- IMU Sensor -->
<gazebo reference="bno055">
        <sensor name="bno055" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>bno055/imu</topic>
        <gz_frame_id>bno055</gz_frame_id>
        <imu>
                <angular_velocity>
                <x>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        </noise>
                </x>
                <y>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        </noise>
                </y>
                <z>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        </noise>
                </z>
                </angular_velocity>
                <linear_acceleration>
                <x>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        </noise>
                </x>
                <y>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        </noise>
                </y>
                <z>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        </noise>
                </z>
                </linear_acceleration>
        </imu>
        </sensor>
</gazebo>

<!-- LiDAR Sensor -->
<gazebo reference="lidar_link">
        <sensor name="rplidar_a1" type="gpu_lidar">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>12</update_rate>
                <topic>scan</topic>
                <gz_frame_id>lidar_link</gz_frame_id>
                <ray>
                        <scan>
                        <horizontal>
                                <samples>360</samples>
                                <resolution>1</resolution>
                                <min_angle>0</min_angle>
                                <max_angle>6.28318</max_angle>
                        </horizontal>
                        </scan>
                        <range>
                        <min>0.12</min>
                        <max>12.0</max>
                        <resolution>0.015</resolution>
                        </range>
                </ray>
        </sensor>
</gazebo>

<!-- ROS2 Control Plugin and Topic Remapping -->
<gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find uiabot_mecanum)/config/mecanum_drive_controller.yaml</parameters>
      <ros>
        <remapping>/mecanum_drive_controller/odom:=/odom</remapping>
      </ros>
    </plugin>
</gazebo>
  
</robot>