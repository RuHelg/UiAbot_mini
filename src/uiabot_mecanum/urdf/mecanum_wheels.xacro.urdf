<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Instantiate four wheels using the common wheel link macro -->

<xacro:base_link
  name="base_link"
  link_mesh="package://uiabot_mecanum/meshes/base_link_mecanum.STL"
  wheel_radius="${wheel_radius}"
  joint_origin="0 0.0 ${wheel_radius}"
  joint_rpy="0 0 0"/>

<xacro:wheel_link
  name="front_left_wheel"
  link_mesh="package://uiabot_mecanum/meshes/Mecanum Wheel Left.STL"
  wheel_radius="${wheel_radius}"
  joint_origin="38.1e-3 102.5e-3 ${wheel_radius}"
  joint_rpy="${-pi/2} 0 0"
  visual_rpy="0 0 0"/>


<xacro:wheel_link
  name="front_right_wheel"
  link_mesh="package://uiabot_mecanum/meshes/Mecanum Wheel Right.STL"
  wheel_radius="${wheel_radius}"
  joint_origin="38.1e-3 -102.5e-3 ${wheel_radius}"
  joint_rpy="${-pi/2} 0 0"
  visual_rpy="0 0 0"/>

<xacro:wheel_link
  name="rear_left_wheel"
  link_mesh="package://uiabot_mecanum/meshes/Mecanum Wheel Right.STL"
  wheel_radius="${wheel_radius}"
  joint_origin="-36.4e-3 102.5e-3 ${wheel_radius}"
  joint_rpy="${-pi/2} 0 0"
  visual_rpy="${pi} 0 0"/>


<xacro:wheel_link
  name="rear_right_wheel"
  link_mesh="package://uiabot_mecanum/meshes/Mecanum Wheel Left.STL"
  wheel_radius="${wheel_radius}"
  joint_origin="-36.4e-3 -102.5e-3 ${wheel_radius}"
  joint_rpy="${-pi/2} 0 0"
  visual_rpy="${pi} 0 0"/>

</robot>
